    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "coral",
    "skill"
  ],
  "license": "MIT"
}
