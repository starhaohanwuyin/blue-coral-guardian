# ============================================================
#  蓝珊·珊瑚卫士 —— Git 忽略规则
#  原则：**代码 + 演示必需的小数据入库；权重与大数据不入库**
# ============================================================

# ---- 模型权重（单文件 106MB，超过 GitHub 100MB 限制；用 Release 附件分发）----
weights/
*.pt
*.pth
*_backup.pt
*_archive.pt

# ---- 交付包与训练产物 ----
delivery/
delivery.zip
ai-service/runs/

# ---- 大数据：NOAA 原始日数据（2.8GB，只保留演示所需的 2 个 JSON）----
ai-service/data/noaa/*
!ai-service/data/noaa/climate_index.json
!ai-service/data/noaa/site_profiles.json

# ---- 大数据：训练/评测集（只保留 e2e 与演示用的小样本）----
ai-service/data/raw/
ai-service/data/cache/
ai-service/data/inat/
ai-service/data/inat_dataset/
ai-service/data/yolo_coral/
ai-service/data/yolo_manual/
ai-service/data/degraded/
ai-service/data/semporna_photos/*.jpg
!ai-service/data/semporna_photos/178481688_38453.jpg
!ai-service/data/semporna_photos/19134925_14088.jpg
!ai-service/data/semporna_photos/196182754_17697.jpg
