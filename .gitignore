!ai-service/data/semporna_photos/85056672_91402.jpg
!ai-service/data/semporna_photos/89269550_48843.jpg

# processed 下只保留白化检测演示样本（e2e 依赖 /sample?set=bleached）
ai-service/data/processed/*
!ai-service/data/processed/bleaching_ip/
ai-service/data/processed/bleaching_ip/*
!ai-service/data/processed/bleaching_ip/test_ip/
ai-service/data/processed/bleaching_ip/test_ip/*
!ai-service/data/processed/bleaching_ip/test_ip/bleached/
!ai-service/data/processed/bleaching_ip/test_ip/healthy/

# ---- 通用 ----
data/raw/
*.csv
__pycache__/
*.pyc
*.pyo
