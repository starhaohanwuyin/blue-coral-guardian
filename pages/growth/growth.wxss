/* ================= 成长档案页 ================= */
.growth-page {
  padding: 32rpx 32rpx 60rpx;
}

.growth-chart-card {
  padding: 24rpx;
}

/* 柱状图 */
.growth-chart {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 280rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--border);
}
.growth-bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.growth-bar {
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
  background: linear-gradient(180deg, var(--primary), var(--accent));
  min-height: 16rpx;
  animation: growUp 0.8s ease both;
}
@keyframes growUp {
  from { height: 16rpx; }
}
.growth-bar-label {
  font-size: 20rpx;
  color: var(--text3);
}
.growth-bar-val {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 指标卡 */
.growth-metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.growth-metric-card {
  background: rgba(30, 136, 229, 0.06);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
}
.growth-metric-card .val {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}
.growth-metric-card .val.green {
  color: var(--green);
}
.growth-metric-card .lbl {
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 4rpx;
}

.growth-section-title {
  font-size: 30rpx;
  font-weight: 700;
  padding: 32rpx 0 24rpx;
}
