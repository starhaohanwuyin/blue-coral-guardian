/* ============ 全部种类页 ============ */
.as-intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
}
.as-intro-icon { font-size: 48rpx; }
.as-intro-text {
  font-size: 26rpx;
  color: var(--text2);
  font-weight: 500;
}
.as-section-title {
  padding: 24rpx 40rpx 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

/* 热门：双列 */
.as-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx;
}
.as-card {
  width: calc((100% - 20rpx) / 2);
  overflow: hidden;
}
.as-imgwrap { position: relative; height: 220rpx; }
.as-img { width: 100%; height: 100%; }
.as-hot-badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 14rpx;
  background: var(--coral);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 12rpx;
}
.as-body { padding: 20rpx 24rpx 26rpx; }
.as-name { font-size: 30rpx; font-weight: 700; }
.as-latin {
  font-size: 20rpx;
  color: var(--primary);
  font-style: italic;
  margin-top: 4rpx;
}
.as-desc {
  font-size: 22rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.as-dist { font-size: 20rpx; color: var(--text3); margin-top: 10rpx; }

/* 全部：列表 */
.as-list { padding: 0 32rpx 40rpx; }
.as-row {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.as-row-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--border);
}
.as-row-body { flex: 1; min-width: 0; }
.as-row-name { font-size: 28rpx; font-weight: 700; }
.as-row-latin {
  font-size: 20rpx;
  color: var(--primary);
  font-style: italic;
  font-weight: 400;
  margin-left: 8rpx;
}
.as-row-desc {
  font-size: 22rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.as-row-dist { font-size: 20rpx; color: var(--text3); margin-top: 8rpx; }
