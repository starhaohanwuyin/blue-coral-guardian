/* ============ 知识问答页 ============ */
.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 40rpx 16rpx;
}
.quiz-progress-text { font-size: 26rpx; color: var(--text2); font-weight: 600; }
.quiz-score { font-size: 26rpx; color: var(--primary); font-weight: 600; }

.quiz-progress-bar {
  height: 10rpx;
  margin: 0 40rpx;
  background: var(--border);
  border-radius: 5rpx;
  overflow: hidden;
}
.quiz-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 5rpx;
  transition: width 0.4s ease;
}

.quiz-card {
  margin: 24rpx 32rpx;
  padding: 36rpx;
}
.quiz-question {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.6;
}

.quiz-options { margin-top: 32rpx; }
.quiz-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border);
  background: var(--bg);
  margin-bottom: 18rpx;
  transition: all 0.2s;
}
.quiz-option-letter {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text2);
  flex-shrink: 0;
}
.quiz-option-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text);
  line-height: 1.5;
}
.quiz-option.correct {
  border-color: var(--green);
  background: rgba(76, 175, 80, 0.08);
}
.quiz-option.correct .quiz-option-letter {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
}
.quiz-option.wrong {
  border-color: var(--coral);
  background: rgba(255, 112, 67, 0.08);
}
.quiz-option.wrong .quiz-option-letter {
  background: var(--coral);
  border-color: var(--coral);
  color: #fff;
}

.quiz-feedback {
  margin-top: 8rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.quiz-feedback.good {
  background: rgba(76, 175, 80, 0.08);
  color: var(--green);
}
.quiz-feedback.bad {
  background: rgba(255, 112, 67, 0.08);
  color: var(--coral);
}

.quiz-next-btn {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.3);
}

/* 结果页 */
.quiz-result {
  margin: 60rpx 32rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}
.quiz-result-icon {
  font-size: 110rpx;
  animation: floatSoft 3s ease-in-out infinite;
}
.quiz-result-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 24rpx;
}
.quiz-result-score {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 16rpx;
}
.quiz-result-desc {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.7;
  margin-top: 20rpx;
}
.quiz-result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}
.quiz-again-btn {
  flex: 1;
  padding: 22rpx;
  border-radius: 26rpx;
  border: 3rpx solid var(--primary);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}
.quiz-learn-btn {
  flex: 1;
  padding: 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
