<!-- 科普页：种类横滑 + 分类筛选 + 文章网格 -->
<view class="page-body">
  <!-- 自定义导航头 -->
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-header-row">
      <view class="logo">📚 珊瑚科普</view>
      <view class="sub">探索珊瑚的奇妙世界</view>
    </view>
  </view>

  <!-- Hero -->
  <view class="knowledge-hero">
    <view class="kh-fish kh-fish-1">🐠</view>
    <view class="kh-fish kh-fish-2 reverse">🐟</view>
    <view class="kh-bubble"></view>
    <view class="kh-title">探索珊瑚的奇妙世界</view>
    <view class="kh-sub">认识南海珊瑚 · 了解生态修复</view>
  </view>

  <!-- 珊瑚种类横滑 -->
  <view class="section-title">珊瑚种类 <text class="more" bindtap="goAllSpecies">查看全部</text></view>
  <scroll-view class="coral-species-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="coral-species-card" wx:for="{{species}}" wx:key="name" hover-class="card-hover" bindtap="goAllSpecies">
      <view class="coral-species-imgwrap">
        <image class="coral-species-img" src="{{item.img}}" mode="aspectFill" lazy-load />
      </view>
      <view class="coral-species-body">
        <view class="coral-species-name">{{item.name}}</view>
        <view class="coral-species-latin">{{item.latin}}</view>
        <view class="coral-species-desc">{{item.desc}}</view>
        <view class="coral-species-dist">📍 {{item.dist}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 分类筛选 -->
  <scroll-view class="knowledge-categories" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="cat-chip {{filter === item.key ? 'active' : ''}}"
      bindtap="onFilter"
      data-key="{{item.key}}"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 科普网格 -->
  <view class="knowledge-grid">
    <view class="knowledge-item card" wx:for="{{filteredItems}}" wx:key="id" hover-class="card-hover" bindtap="goDetail" data-id="{{item.id}}">
      <view class="knowledge-item-imgwrap">
        <image class="knowledge-item-img" src="{{item.img}}" mode="aspectFill" lazy-load />
      </view>
      <view class="knowledge-item-body">
        <view class="knowledge-item-title">{{item.title}}</view>
        <view class="knowledge-item-summary">{{item.summary}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!filteredItems.length}}" class="empty-tip">该分类暂无内容</view>
</view>
