/* ============ 实时海景页 ============ */
.cam-view {
  position: relative;
  height: 700rpx;
  background: #0D47A1;
  overflow: hidden;
}
.cam-img { width: 100%; height: 100%; }

.cam-live {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  background: rgba(211, 47, 47, 0.85);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 24rpx;
  letter-spacing: 2rpx;
}
.cam-live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
  animation: pulse 1.2s ease-in-out infinite;
}

.cam-location {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}
.cam-coord {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  font-family: monospace;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

.cam-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  animation: bubbleUp linear infinite;
}
.cb-1 { left: 20%; bottom: 60rpx; width: 14rpx; height: 14rpx; animation-duration: 6s; }
.cb-2 { left: 55%; bottom: 40rpx; width: 10rpx; height: 10rpx; animation-duration: 8s; animation-delay: 2s; }
.cb-3 { left: 78%; bottom: 80rpx; width: 12rpx; height: 12rpx; animation-duration: 7s; animation-delay: 4s; }

/* 指标 */
.cam-metrics {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
}
.cam-metric {
  flex: 1;
  padding: 28rpx 16rpx;
  text-align: center;
}
.cam-metric-icon { font-size: 44rpx; }
.cam-metric-label {
  font-size: 24rpx;
  color: var(--text2);
  font-weight: 600;
  margin-top: 12rpx;
}

/* 说明 */
.cam-note {
  margin: 0 32rpx 48rpx;
  padding: 32rpx;
}
.cam-note-title {
  font-size: 28rpx;
  font-weight: 700;
}
.cam-note-text {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.7;
  margin-top: 14rpx;
}
.cam-refresh {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--primary);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
