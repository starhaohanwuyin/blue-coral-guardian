/* 协议页样式 */
.doc-page {
  min-height: 100vh;
  background: #F5F9FF;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.doc-header {
  text-align: center;
  padding: 24rpx 0 36rpx;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F2A4A;
  letter-spacing: 2rpx;
}

.doc-update {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8A97A8;
}

.doc-body {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 42, 74, 0.06);
}

.doc-section {
  margin-bottom: 40rpx;
}

.doc-section:last-child {
  margin-bottom: 0;
}

.doc-h {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E88E5;
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4DD0E1;
}

.doc-p {
  font-size: 27rpx;
  line-height: 1.85;
  color: #3D4A5C;
  margin-bottom: 14rpx;
  text-align: justify;
}

.doc-p:last-child {
  margin-bottom: 0;
}

.doc-footer {
  text-align: center;
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #9AA5B4;
  letter-spacing: 2rpx;
}
