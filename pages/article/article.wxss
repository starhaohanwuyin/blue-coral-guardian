/* ============ 推文/资讯详情页 ============ */
.art-hero {
  width: 100%;
  height: 420rpx;
  display: block;
}
.art-body {
  margin: -60rpx 32rpx 0;
  position: relative;
  z-index: 2;
  padding: 40rpx 36rpx 48rpx;
}
.art-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
}
.art-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.art-date { font-size: 22rpx; color: var(--text3); }
.art-divider {
  height: 2rpx;
  background: var(--border);
  margin: 28rpx 0;
}
.art-summary {
  font-size: 28rpx;
  color: var(--text2);
  line-height: 1.9;
}
.art-nolink {
  font-size: 24rpx;
  color: var(--text3);
  margin-top: 32rpx;
  text-align: center;
}

.art-link {
  margin-top: 32rpx;
  padding: 28rpx;
  background: var(--bg);
  box-shadow: none;
}
.art-link-title {
  font-size: 28rpx;
  font-weight: 600;
}
.art-link-url {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 12rpx;
  word-break: break-all;
  line-height: 1.6;
}
.art-link-btn {
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
.art-link-tip {
  font-size: 20rpx;
  color: var(--text3);
  margin-top: 16rpx;
  text-align: center;
}
