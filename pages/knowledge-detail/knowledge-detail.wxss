/* ============ 科普详情页 ============ */
.kd-hero {
  width: 100%;
  height: 420rpx;
  display: block;
}
.kd-body {
  margin: -60rpx 32rpx 0;
  position: relative;
  z-index: 2;
  padding: 40rpx 36rpx;
}
.kd-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}
.kd-summary {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.7;
  margin-top: 16rpx;
}
.kd-divider {
  height: 2rpx;
  background: var(--border);
  margin: 32rpx 0;
}
.kd-paragraph {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.9;
  margin-bottom: 24rpx;
}
.kd-actions { padding: 32rpx; }
.kd-share-btn {
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.3);
}
