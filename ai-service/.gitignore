# ==========================================================
#  ai-service（算法服务）Git 忽略规则
#  原则：**代码 + 演示必需的小数据入库；权重与大数据不入库**
#
#  注意：本文件比仓库根目录的 .gitignore 优先级更高
#        （Git 规则：下层目录的规则覆盖上层），所以 data/ 的
#        例外必须写在这里，写在根目录无效。
# ==========================================================

# ---- 模型权重（每个 106MB，超过 GitHub 单文件 100MB 限制；走 Release 附件）----
weights/
*.pt
*.pth
*.safetensors
*.ckpt

# ---- 大数据：NOAA 原始日数据（2.8 GB）→ 只保留演示所需的 2 个 JSON ----
data/noaa/*
!data/noaa/climate_index.json
!data/noaa/site_profiles.json

# ---- 大数据：训练/评测集 → 只保留 e2e 与演示用的小样本 ----
data/raw/
data/cache/
data/inat/
data/inat_dataset/
data/yolo_coral/
data/yolo_manual/
data/degraded/
data/semporna_photos/*.jpg
!data/semporna_photos/19134925_14088.jpg
!data/semporna_photos/196182754_17697.jpg
!data/semporna_photos/256659186_30150.jpg
!data/semporna_photos/256864542_89167.jpg
!data/semporna_photos/258166706_53189.jpg
!data/semporna_photos/361935269_31960.jpg
!data/semporna_photos/41772405_45825.jpg
!data/semporna_photos/51691866_60253.jpg
!data/semporna_photos/70531002_51492.jpg
!data/semporna_photos/85056672_91402.jpg
!data/semporna_photos/89269550_48843.jpg

# processed 下只保留白化检测演示样本（e2e 依赖 /sample?set=bleached）
data/processed/*
!data/processed/bleaching_ip/
data/processed/bleaching_ip/*
!data/processed/bleaching_ip/test_ip/
data/processed/bleaching_ip/test_ip/*
!data/processed/bleaching_ip/test_ip/bleached/
!data/processed/bleaching_ip/test_ip/healthy/

# ---- 其他大文件与产物 ----
*.csv
# 珊瑚图鉴数据库（运行时生成；种子数据 data/corals/coral_species.json 入库）
data/corals/*.db
data/corals/*.db-wal
data/corals/*.db-shm
data/corals/uploads/
runs/
reports/*.log
*.log
delivery/
delivery.zip

# ---- Python / 编辑器 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.tmp
*.tmpdir/
*.partial.json
*.backup.json
*.bak
*.orig
