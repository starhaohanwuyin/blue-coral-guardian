<!-- 科普详情页 -->
<view class="page-body lang-{{lang}}">
  <view wx:if="{{item}}">
    <image class="kd-hero" src="{{item.img}}" mode="aspectFill" />
    <view class="kd-body card">
      <view class="kd-title">{{item.title}}</view>
      <view class="kd-summary">{{item.summary}}</view>
      <view class="kd-divider"></view>
      <view class="kd-paragraph" wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this">{{p}}</view>

      <!-- 延伸阅读：真实外链，网页版可直接打开 -->
      <view wx:if="{{item.link}}" class="kd-link">
        <view class="kd-link-title">{{t.pjj4ybc}} {{item.linkName || '原文'}}</view>
        <view class="kd-link-url">{{item.link}}</view>
        <view class="kd-link-btn" hover-class="btn-hover" bindtap="onOpenLink">{{t.p1ss0lyv}}</view>
        <view class="kd-link-btn ghost" hover-class="btn-hover" bindtap="onCopyLink">{{t.p2zaaqj}}</view>
      </view>
    </view>
    <view class="kd-actions">
      <view class="kd-share-btn" hover-class="btn-hover" bindtap="goQuiz">{{t.pb2h6ej}}</view>
    </view>
  </view>
  <view wx:else class="loading-dots">{{t.pldc0z9}}</view>
</view>
