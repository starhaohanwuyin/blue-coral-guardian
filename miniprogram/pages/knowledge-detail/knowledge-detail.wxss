/* ============ 科普详情页 ============ */
.kd-hero {
  width: 100%;
  height: 420rpx;
  display: block;
}
.kd-body {
  margin: -60rpx 32rpx 0;
  position: relative;
  z-index: 2;
  padding: 40rpx 36rpx;
}
.kd-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}
.kd-summary {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.7;
  margin-top: 16rpx;
}
.kd-divider {
  height: 2rpx;
  background: var(--border);
  margin: 32rpx 0;
}
.kd-paragraph {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.9;
  margin-bottom: 24rpx;
}
.kd-actions { padding: 32rpx; }
.kd-link {
  margin-top: 32rpx;
  padding: 28rpx;
  background: var(--bg);
  border-radius: 24rpx;
}
.kd-link-title {
  font-size: 26rpx;
  font-weight: 600;
}
.kd-link-url {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 12rpx;
  word-break: break-all;
  line-height: 1.6;
}
.kd-link-btn {
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
.kd-link-btn.ghost {
  margin-top: 16rpx;
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--primary);
  font-weight: 500;
}
.kd-share-btn {
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.3);
}
