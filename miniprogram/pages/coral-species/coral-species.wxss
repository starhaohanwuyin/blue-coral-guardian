/* ============ 珊瑚种类详情页 ============ */
.cs-hero {
  position: relative;
  height: 460rpx;
  overflow: hidden;
}
.cs-hero-img { width: 100%; height: 100%; display: block; }
.cs-hero-ph {
  background: linear-gradient(160deg, #0d47a1, #1e88e5 55%, #26a69a);
}
.cs-hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(6, 34, 60, 0), rgba(6, 34, 60, 0.82));
}
.cs-hero-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 26rpx;
  color: #fff;
}
.cs-name { font-size: 44rpx; font-weight: 700; }
.cs-latin { font-size: 24rpx; font-style: italic; opacity: 0.9; margin-top: 6rpx; }
.cs-badges { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.cs-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
}
.cs-badge.hot { background: var(--coral); }
.cs-badge.ai { background: rgba(30, 136, 229, 0.92); }
.cs-note {
  padding: 16rpx 32rpx 0;
  font-size: 20rpx;
  color: var(--text3);
  line-height: 1.6;
}
.cs-section {
  margin: 24rpx 32rpx;
  padding: 28rpx 30rpx 12rpx;
}
.cs-section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}
.cs-row {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border);
}
.cs-k {
  width: 210rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text3);
}
.cs-v {
  flex: 1;
  font-size: 25rpx;
  color: var(--text);
  line-height: 1.7;
  word-break: break-all;
}
.cs-actions { padding: 12rpx 32rpx 60rpx; }
.cs-btn {
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.28);
}
.cs-btn.ghost {
  margin-top: 18rpx;
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--primary);
  font-weight: 500;
  box-shadow: none;
}
