/* ============ 全部种类页 ============ */
.as-intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
}
.as-intro-icon { font-size: 48rpx; }
.as-intro-text {
  font-size: 26rpx;
  color: var(--text2);
  font-weight: 500;
}

/* 离线演示提示 */
.as-offline {
  margin: 0 32rpx 8rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(30, 136, 229, 0.18);
  background: linear-gradient(135deg, rgba(30, 136, 229, 0.08), rgba(0, 188, 212, 0.08));
}
.as-offline-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.as-offline-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text2);
}
.as-offline-btn {
  display: inline-block;
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}
.as-section-title {
  padding: 24rpx 40rpx 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

/* 热门：双列 */
.as-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 32rpx;
}
.as-card {
  width: calc((100% - 20rpx) / 2);
  overflow: hidden;
}
.as-imgwrap { position: relative; height: 220rpx; overflow: hidden; }
.as-img-ph {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: rgba(30, 136, 229, 0.28);
  background: linear-gradient(135deg, rgba(30, 136, 229, 0.1), rgba(0, 188, 212, 0.16));
}
.as-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}
.as-hot-badge {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 14rpx;
  background: var(--coral);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 12rpx;
}
.as-body { padding: 20rpx 24rpx 26rpx; }
.as-name { font-size: 30rpx; font-weight: 700; }
.as-latin {
  font-size: 20rpx;
  color: var(--primary);
  font-style: italic;
  margin-top: 4rpx;
}
.as-desc {
  font-size: 22rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.as-dist { font-size: 20rpx; color: var(--text3); margin-top: 10rpx; }

/* 全部：列表 */
.as-list { padding: 0 32rpx 40rpx; }
.as-row {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.as-row-imgwrap {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
}
.as-row-img {
  position: relative;
  z-index: 1;
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: var(--border);
}
.as-row-body { flex: 1; min-width: 0; }
.as-row-name { font-size: 28rpx; font-weight: 700; }
.as-row-latin {
  font-size: 20rpx;
  color: var(--primary);
  font-style: italic;
  font-weight: 400;
  margin-left: 8rpx;
}
.as-row-desc {
  font-size: 22rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.as-row-dist { font-size: 20rpx; color: var(--text3); margin-top: 8rpx; }
