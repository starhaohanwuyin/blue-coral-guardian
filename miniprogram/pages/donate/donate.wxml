<!-- 公益捐赠页 -->
<view class="page-body lang-{{lang}}">
  <!-- 头部 -->
  <view class="dn-hero">
    <view class="dn-hero-icon">💚</view>
    <view class="dn-hero-title">{{t.pi7sera}}</view>
    <view class="dn-hero-sub">{{t.p1akwncz}}</view>
  </view>

  <!-- 金额选择 -->
  <view class="dn-card card">
    <view class="dn-section-label">{{t.p1ehlbhx}}</view>
    <view class="dn-amounts">
      <view
        wx:for="{{amounts}}"
        wx:key="*this"
        class="dn-amount-btn {{amount === item && !customMode ? 'active' : ''}}"
        bindtap="onSelectAmount"
        data-amount="{{item}}"
      >¥{{item}}</view>
    </view>

    <view class="dn-section-label">{{t.pnzhene}}</view>
    <view class="dn-custom-row">
      <text class="dn-custom-unit">¥</text>
      <input
        class="dn-custom-input"
        type="digit"
        placeholder="{{t.p16370pp}}"
        value="{{customAmount}}"
        bindinput="onCustomInput"
      />
    </view>

    <!-- 捐赠说明 -->
    <view class="dn-desc">
      <view class="dn-desc-title">{{t.p1ua23zf}}</view>
      <view class="dn-desc-line">{{t.p1e1lxi0}}</view>
      <view class="dn-desc-line">{{t.pgdz5g1}}</view>
      <view class="dn-desc-line">{{t.p1nu5zw2}}</view>
      <view class="dn-desc-line">{{t.p1carcfr}}</view>
    </view>

    <view class="dn-confirm-btn" hover-class="btn-hover" bindtap="onDonate">{{t.p1w69gg1}}{{amount || customAmount || 0}}</view>
    <view class="dn-agreement">{{t.puzkvu5}}</view>
  </view>
</view>
