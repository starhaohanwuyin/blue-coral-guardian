/* ============ 公益捐赠页 ============ */
.dn-hero {
  margin: 24rpx 32rpx;
  padding: 56rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #2E7D32, #4CAF50 60%, #66BB6A);
  color: #fff;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(76, 175, 80, 0.3);
}
.dn-hero-icon {
  font-size: 80rpx;
  animation: floatSoft 3s ease-in-out infinite;
}
.dn-hero-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 16rpx;
}
.dn-hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  margin-top: 14rpx;
}

.dn-card {
  margin: 0 32rpx 48rpx;
  padding: 36rpx;
}
.dn-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 20rpx;
}
.dn-amounts {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.dn-amount-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 24rpx;
  border: 3rpx solid var(--border);
  background: var(--bg);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text2);
  box-sizing: border-box;
}
.dn-amount-btn.active {
  border-color: var(--green);
  color: var(--green);
  background: rgba(76, 175, 80, 0.08);
}

.dn-custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 0 28rpx;
  border: 3rpx solid var(--border);
}
.dn-custom-unit {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green);
}
.dn-custom-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
}

.dn-desc {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--bg);
  border-radius: 24rpx;
}
.dn-desc-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.dn-desc-line {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.9;
}

.dn-confirm-btn {
  margin-top: 32rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--green), #66BB6A);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(76, 175, 80, 0.35);
}
.dn-agreement {
  font-size: 20rpx;
  color: var(--text3);
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.6;
}
