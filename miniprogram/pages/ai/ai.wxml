<!-- 珊瑚识别页：上传 → 识别 → 种类 + 白化程度 双结果 -->
<view class="page-body lang-{{lang}}">
  <!-- 自定义导航头 -->
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-header-row">
      <view class="logo">{{t.p1plflqy}}</view>
      <view class="sub">{{t.p1q0e5vi}}</view>
    </view>
  </view>

  <!-- Hero -->
  <view class="ai-hero">
    <view class="ai-hero-icon">🔬</view>
    <view class="ai-hero-title">{{t.p18urenn}}</view>
    <view class="ai-hero-sub">{{t.pnv4ye1}}</view>
  </view>

  <!-- 点位选择：环境背景（海表热压力）随点位变化 -->
  <view class="site-bar card">
    <view class="site-row">
      <text class="site-label">{{t.pf8fqvr}}</text>
      <text class="site-cur">{{siteName}}</text>
    </view>
    <scroll-view class="site-scroll" scroll-x="true">
      <view class="site-chips">
        <view wx:for="{{sites}}" wx:key="name"
              class="site-chip {{index === siteIndex ? 'on' : ''}}"
              data-index="{{index}}" bindtap="onSiteTap">{{item.name}}</view>
        <view class="site-chip loc {{locating ? 'busy' : ''}}" bindtap="useMyLocation">{{locating ? '定位中…' : '用我的位置'}}</view>
      </view>
    </scroll-view>
    <view class="site-row site-row-year">
      <text class="site-label">{{t.pucoy8u}}</text>
      <!-- ⚠️ 用**换行**而不是横向滚动：scroll-view 放在 flex 行里会塌陷/裁切，
           实测 6 个芯片只显示得下 3 个（用户反馈"并未完成"就是这个原因）。
           换行后芯片必然全部可见，不依赖滚动。 -->
      <view class="site-chips site-chips-wrap">
        <view wx:for="{{years}}" wx:key="*this"
              class="site-chip year {{item === year ? 'on' : ''}}"
              data-year="{{item}}" bindtap="onYearTap">{{item}}</view>
        <!-- 完整年份表（1985–2025 共 41 年）：芯片只放常用年，其他年份从这里选。
             选中非快捷年份时，这个芯片显示当前年份并高亮。 -->
        <picker mode="selector" range="{{allYears}}" bindchange="onYearPick">
          <view class="site-chip year pick {{yearIsQuick ? '' : 'on'}}">
            {{yearIsQuick ? '其他年份 ▾' : year}}
          </view>
        </picker>
      </view>
    </view>
    <view class="site-hint">{{t.p1bmjurg}}{{version}}</view>
  </view>

  <!-- ① 上传 -->
  <view wx:if="{{state === 'upload'}}" class="ai-upload-area" hover-class="upload-hover" bindtap="chooseImage">
    <view class="upload-icon">📸</view>
    <view class="upload-title">{{t.pofsme3}}</view>
    <view class="upload-sub">{{t.p1vbjxld}}</view>
  </view>

  <!-- ② 预览 -->
  <view wx:if="{{state === 'preview'}}" class="ai-preview-container card">
    <image wx:if="{{!imgFailed}}" class="ai-preview-img" src="{{imgPath}}" mode="aspectFit" binderror="onImgError" />
    <view wx:else class="img-fallback">{{t.pd6v3uv}}</view>
    <view class="ai-preview-actions">
      <view class="btn-upload-new" hover-class="btn-hover" bindtap="resetUpload">{{t.p12nj0ou}}</view>
      <view class="btn-start" hover-class="btn-hover" bindtap="startAnalysis">{{t.p160i4hr}}</view>
    </view>
  </view>

  <!-- ③ 识别中 -->
  <view wx:if="{{state === 'loading'}}" class="ai-loading card">
    <view class="loading-spinner"></view>
    <view class="loading-text">{{t.p16mup6u}}</view>
    <view class="loading-sub">{{t.p4oipq1}}</view>
    <view class="loading-progress"><view class="loading-progress-bar"></view></view>
  </view>

  <!-- ④ 失败 -->
  <view wx:if="{{state === 'error'}}" class="ai-error card">
    <view class="err-icon">😵</view>
    <view class="err-title">{{t.p9iuz5s}}</view>
    <view class="err-msg">{{errorMsg}}</view>
    <view class="err-actions">
      <view class="btn-upload-new" hover-class="btn-hover" bindtap="checkService">{{t.p12ugoi0}}</view>
      <view class="btn-start" hover-class="btn-hover" bindtap="onRetry">{{t.plswd2v}}</view>
    </view>
    <view class="err-hint">{{t.p3e8y8c}}</view>
  </view>

  <!-- ⑤ 结果 -->
  <block wx:if="{{state === 'result' && result}}">
    <view class="res-photo card">
      <image wx:if="{{!imgFailed}}" class="res-photo-img" src="{{imgPath}}" mode="aspectFit" binderror="onImgError" />
      <view wx:else class="img-fallback">{{t.p1lprgk1}}</view>
    </view>

    <!-- 演示数据标记（服务不可用时的降级，不冒充真实结果） -->
    <view wx:if="{{view.isDemo}}" class="quality-alert warn">
      <view class="qa-title">{{t.p11lwwd7}}</view>
      <view class="qa-desc">{{t.p10w295t}}</view>
      <!-- 显示具体失败原因（含服务地址与排查提示），便于自行定位问题 -->
      <view wx:if="{{view.demoReason}}" class="qa-desc">{{t.p6rdxf4}}{{view.demoReason}}</view>
      <view class="qa-meta">{{t.p1ygtbj}}</view>
    </view>

    <!-- 拍摄条件自检：超出适用边界时置顶警示 -->
    <view wx:if="{{view.qualityPoor}}" class="quality-alert poor">
      <view class="qa-title">{{t.p155ixu2}}</view>
      <view class="qa-desc">{{view.quality.message}}</view>
      <view class="qa-meta" wx:if="{{view.quality.contrast !== null}}">
        {{t.p1llq70f}} {{view.quality.contrast}}{{t.pldb0kz}}{{view.quality.goodContrast}}{{t.p10y969b}}
      </view>
    </view>
    <view wx:elif="{{view.qualityWarn && !view.isDemo}}" class="quality-alert warn">
      <view class="qa-title">{{t.pw58ver}}</view>
      <view class="qa-desc">{{view.quality.message}}</view>
    </view>

    <!-- 礁区覆盖评估（语义分割） -->
    <view class="res-card card">
      <view class="res-head">
        <text class="res-head-icon">📊</text>
        <text class="res-head-title">{{t.p11ub9ii}}</text>
        <text class="res-head-badge">{{t.p1ykqbet}} {{view.coralTotal}}%</text>
      </view>

      <view class="prob-list">
        <view class="prob-row" wx:for="{{view.groupBars}}" wx:key="key">
          <text class="prob-name">{{item.name}}</text>
          <view class="prob-bar">
            <view class="prob-fill {{item.cls}}" style="width: {{item.pct}}%;"></view>
          </view>
          <text class="prob-val">{{item.pct}}%</text>
        </view>
      </view>

      <view class="cover-summary">
        <text>{{t.polyox2}} {{view.coralTotal}}%</text>
        <text wx:if="{{view.bleachingShare > 0}}"> {{t.pfims1w}} {{view.bleachingShare}}%</text>
      </view>

      <view wx:if="{{view.bleachAlert}}" class="review-tip" style="margin: 16rpx 0 0;">
        {{t.pwl0u1f}}
      </view>
    </view>

    <!-- 白化状态（分类模型） -->
    <view class="res-card card" wx:if="{{view.hasBleach}}">
      <view class="res-head">
        <text class="res-head-icon">🩺</text>
        <text class="res-head-title">{{t.p1dzxlcz}}</text>
        <text class="res-head-badge">{{view.bleachView.pct}}%</text>
      </view>
      <view class="res-main">{{view.bleachView.labelCn}}</view>
      <view class="conf-bar"><view class="conf-fill" style="width: {{view.bleachView.pct}}%;"></view></view>
      <view class="prob-list" style="margin-top: 18rpx;">
        <view class="prob-row" wx:for="{{view.bleachView.probs}}" wx:key="key">
          <text class="prob-name">{{item.name}}</text>
          <view class="prob-bar">
            <view class="prob-fill {{item.key}}" style="width: {{item.pct}}%;"></view>
          </view>
          <text class="prob-val">{{item.pct}}%</text>
        </view>
      </view>
      <view wx:if="{{view.bleachView.review}}" class="review-tip" style="margin-top: 16rpx;">
        {{t.pdlnhe7}}{{view.bleachView.labelCn}}{{t.p1c46cr1}}{{view.bleachView.altLabelCn}}{{t.p1m0wojl}}
      </view>
      <view wx:elif="{{view.bleachView.note}}" class="note-tip" style="margin-top: 16rpx;">
        {{t.p1mt3819}}{{view.bleachView.altLabelCn}}{{t.paa9pfg}}{{view.bleachView.pct}}{{t.pvl5s61}}
      </view>
      <view wx:elif="{{view.bleachView.hasConsensus && view.bleachView.agree}}" class="agree-tip" style="margin-top: 16rpx;">
        {{t.pe9hwis}}{{view.bleachView.labelCn}} {{view.bleachView.pct}}{{t.plwwk6i}}
      </view>
      <view wx:if="{{!view.bleachView.reliable}}" class="review-tip" style="margin-top: 16rpx;">
        {{t.p15oz1ry}}
      </view>
      <view class="bleach-tip">
        {{t.p1e6nzf5}}{{view.bleachView.model}}{{t.p1wbu3zq}}
      </view>
    </view>

    <!-- 珊瑚属识别 -->
    <view class="res-card card" wx:if="{{view.hasGenus}}">
      <view class="res-head">
        <text class="res-head-icon">🪸</text>
        <text class="res-head-title">{{t.pw9y2vx}}</text>
        <text class="res-head-badge">{{t.paln58d}}</text>
      </view>
      <view class="res-main">{{view.genusTop[0].genus}}</view>
      <view class="conf-bar"><view class="conf-fill" style="width: {{view.genusTop[0].pct}}%;"></view></view>
      <view class="top3" wx:if="{{view.genusTop.length > 1}}">
        <view class="top3-title">{{t.p1f49swx}}</view>
        <view class="top3-item" wx:for="{{view.genusTop}}" wx:key="genus" wx:if="{{index > 0}}">
          <text class="t3-name">{{item.genus}}</text>
          <text class="t3-conf">{{item.pct}}%</text>
        </view>
      </view>
      <view class="bleach-tip">{{t.pdmz8xl}}</view>
    </view>
    <view class="res-card card" wx:else>
      <view class="res-head">
        <text class="res-head-icon">🪸</text>
        <text class="res-head-title">{{t.pw9y2vx}}</text>
      </view>
      <view class="bleach-tip">{{t.p1xbctym}}</view>
    </view>

    <!-- 主要底栖类别 -->
    <view class="res-card card" wx:if="{{view.topClasses.length > 0}}">
      <view class="res-head">
        <text class="res-head-icon">🔬</text>
        <text class="res-head-title">{{t.p1m9gbp8}}</text>
      </view>
      <view class="top3-item" wx:for="{{view.topClasses}}" wx:key="name">
        <text class="t3-name">{{item.name}}</text>
        <text class="t3-conf">{{item.pct}}%</text>
      </view>
    </view>

    <!-- 使用边界 -->
    <view class="disclaimer">{{result.disclaimer}}</view>
    <view class="disclaimer-sub">{{t.p1bn20hq}} {{view.inferenceMs}} {{t.p1j5har}}</view>

    <view class="result-action-btn" hover-class="btn-hover" bindtap="resetUpload">{{t.p18wbtf6}}</view>
<!-- ============ 环境数据：海表热压力（NOAA CRW）============ -->
<view class="res-card card" wx:if="{{view.climate}}">
  <!-- 标题竖排：点位 · 年份口径（副标题）很长，横排会把「环境数据 · 海表热压力」挤成三行 -->
  <view class="res-title res-title-stack">
    <text>{{t.p1y7eu3s}}</text>
    <text class="res-sub">{{view.climate.siteName}} · {{view.climate.year}} {{t.ph63o1i}}</text>
  </view>
  <view class="climate-head climate-{{view.climate.level}}">
    <view class="climate-grade">{{view.climate.baaLabel}}</view>
    <view class="climate-dhw">{{t.pg6tu62}} {{view.climate.dhwMax}}</view>
  </view>
  <view class="climate-rows">
    <view class="climate-row">
      <text class="cr-k">{{t.pfjtmef}}</text>
      <text class="cr-v">{{t.p13g8kyg}} {{view.climate.daysGe4}} {{t.p1xh609m}} {{view.climate.daysGe8}} {{t.pcae2ro}}</text>
    </view>
    <view class="climate-row" wx:if="{{view.climate.peakDate}}">
      <text class="cr-k">{{t.p14tvyht}}</text>
      <text class="cr-v">{{view.climate.peakDate}}</text>
    </view>
    <view class="climate-row" wx:if="{{view.climate.anomalyNote}}">
      <text class="cr-k">{{t.p1c6aa9e}}</text>
      <text class="cr-v">{{view.climate.anomalyNote}}</text>
    </view>
    <!-- 41 年历史（来自同一次响应的 deployment），避免把单年等级误读为常态 -->
    <view class="climate-row" wx:if="{{view.climate.hasHistory}}">
      <text class="cr-k">{{t.p1h7h0ea}}</text>
      <text class="cr-v">{{t.pn2yd8c}} {{view.climate.historyYears}} {{t.p1uy3d7n}} {{view.climate.historyText}}{{view.climate.severeText ? '；' + view.climate.severeText : ''}}</text>
    </view>
    <view class="climate-row" wx:if="{{view.climate.avoidText}}">
      <text class="cr-k">{{t.pe2kypi}}</text>
      <text class="cr-v">{{view.climate.avoidText}}<text wx:if="{{view.climate.avoidNote}}">（{{view.climate.avoidNote}}）</text></text>
    </view>
  </view>
  <view class="climate-verdict">{{view.climate.verdict}}</view>
</view>

<!-- ============ 综合研判：修复优先级 + 苗投放建议 ============ -->
<view class="res-card card" wx:if="{{view.restoration}}">
  <view class="res-title">
    <text>{{t.pm732ey}}</text>
    <text class="res-sub">{{t.p16cydni}}</text>
  </view>

  <view class="prio-head prio-{{view.restoration.grade}}">
    <view class="prio-score">{{view.restoration.priority}}<text class="prio-unit">/100</text></view>
    <view class="prio-grade">{{view.restoration.gradeLabel}}</view>
  </view>

  <view class="prio-bars">
    <view class="pb-item">
      <text class="pb-k">{{t.p1xr7cut}}</text>
      <view class="pb-track"><view class="pb-fill pb-rec" style="width: {{view.restoration.recovery}}%"></view></view>
      <text class="pb-v">{{view.restoration.recovery}}</text>
    </view>
    <view class="pb-item">
      <text class="pb-k">{{t.pqgamgw}}</text>
      <view class="pb-track"><view class="pb-fill pb-urg" style="width: {{view.restoration.urgency}}%"></view></view>
      <text class="pb-v">{{view.restoration.urgency}}</text>
    </view>
    <view class="pb-item">
      <text class="pb-k">{{t.p15ldqx3}}</text>
      <view class="pb-track"><view class="pb-fill pb-seed" style="width: {{view.restoration.seedling}}%"></view></view>
      <text class="pb-v">{{view.restoration.seedling}}</text>
    </view>
  </view>

  <view class="prio-actions">
    <view class="pa-item" wx:for="{{view.restoration.actions}}" wx:key="*this">
      <text class="pa-dot">·</text><text class="pa-text">{{item}}</text>
    </view>
  </view>

  <view class="prio-note">{{t.pwg1dde}}</view>
</view>

  </block>

  <!-- 识别历史 -->
  <block wx:if="{{history.length > 0}}">
    <view class="section-title-row">
      <text class="section-title">{{t.p1q5bspy}}</text>
      <text class="section-action" bindtap="clearHistory">{{t.p9mbwb2}}</text>
    </view>
    <view class="ai-history">
      <view class="history-item card" wx:for="{{history}}" wx:key="id"
            hover-class="card-hover" bindtap="onHistoryTap" data-id="{{item.id}}">
        <image wx:if="{{item.img}}" class="history-thumb" src="{{item.img}}" mode="aspectFill" lazy-load
               binderror="onHistoryImgError" data-id="{{item.id}}" />
        <view wx:else class="history-thumb history-thumb-empty">—</view>
        <view class="history-info">
          <view class="history-title">{{t.p1ri9ibh}} {{item.coralTotalPct ? item.coralTotalPct : 0}}%</view>
          <view class="history-sub">{{item.time}}{{item.topGenus ? ' · ' + item.topGenus : ''}}</view>
          <view class="history-tags">
            <text class="htag alive">{{t.phcw7ve}} {{item.alivePct ? item.alivePct : 0}}%</text>
            <text class="htag bleached">{{t.p1xmeom2}} {{item.bleachedPct ? item.bleachedPct : 0}}%</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 能力说明 -->
  <view class="section-title">{{t.p1jnviw7}}</view>
  <view class="ai-tech-section">
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(30,136,229,0.1);">📊</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.p17bndll}}</view>
        <view class="ai-tech-desc">{{t.png4dar}}</view>
      </view>
    </view>
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(156,39,176,0.1);">🪸</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.p1g69j3o}}</view>
        <view class="ai-tech-desc">{{t.p579uo1}} <text style="font-weight:600;">86.12%</text>{{t.pzqx7n}}</view>
      </view>
    </view>
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(255,112,67,0.1);">🩺</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.p15s7xqg}}</view>
        <view class="ai-tech-desc">{{t.p1ecnbfo}}</view>
      </view>
    </view>
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(255,112,67,0.1);">📏</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.pblljqm}}</view>
        <view class="ai-tech-desc">{{t.p11fjy8f}}</view>
      </view>
    </view>
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(76,175,80,0.1);">🔬</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.p7ok1a7}}</view>
        <view class="ai-tech-desc">{{t.pf4jg5s}}</view>
      </view>
    </view>
    <view class="ai-tech-card card">
      <view class="ai-tech-icon" style="background: rgba(255,193,7,0.12);">📏</view>
      <view class="ai-tech-info">
        <view class="ai-tech-title">{{t.pb6s1yc}}</view>
        <view class="ai-tech-desc">{{t.p1l4hy53}}<text style="font-weight:600;">{{t.p1tyc5ba}}</text>{{t.pz6pw1k}}</view>
      </view>
    </view>
  </view>
</view>
