<view class="cert-page {{type}} lang-{{lang}}">

  <!-- 实体认养证书（金色 premium 版式） -->
  <view class="cert-card entity" wx:if="{{cert && type === 'entity'}}">
    <view class="cert-outer-border"></view>
    <view class="cert-inner-border"></view>
    <view class="cert-corner tl"></view>
    <view class="cert-corner tr"></view>
    <view class="cert-corner bl"></view>
    <view class="cert-corner br"></view>
    <view class="cert-content">
      <view class="cert-top-label">{{cert.topLabel}}</view>
      <view class="cert-main-title">{{cert.title}}</view>
      <view class="cert-sub-title">{{cert.subTitle}}</view>
      <image class="cert-coral-circle" src="{{cert.img}}" mode="aspectFill" />
      <view class="cert-field-row" wx:for="{{cert.fields}}" wx:key="label">
        <text class="label">{{item.label}}</text>
        <text class="value">{{item.value}}</text>
      </view>
      <view class="cert-seal">
        <view class="cert-seal-stamp">
          <view class="cert-seal-text">{{t.pnorp5y}}<text class="seal-br">{{t.p1b2tgfq}}</text></view>
        </view>
        <view class="cert-org-name">{{cert.org}}</view>
        <view class="cert-date-line">{{cert.issueDate}}</view>
      </view>
    </view>
  </view>

  <!-- 虚拟认养证书（青色版式） -->
  <view class="cert-card virtual" wx:if="{{cert && type === 'virtual'}}">
    <view class="v-border"></view>
    <view class="v-top-label">{{cert.topLabel}}</view>
    <view class="v-main-title">{{cert.title}}</view>
    <view class="v-sub-title">{{cert.subTitle}}</view>
    <view class="v-coral-icon">🪸</view>
    <view class="v-field" wx:for="{{cert.fields}}" wx:key="label">
      <text class="label">{{item.label}}</text>
      <text class="value">{{item.value}}</text>
    </view>
    <view class="v-seal">
      <view class="v-seal-icon">🐚</view>
      <view class="v-org">{{cert.org}}</view>
    </view>
  </view>

  <!-- 加载骨架 -->
  <view class="cert-loading" wx:if="{{!cert}}">
    <view class="cert-loading-icon">📜</view>
    <view class="cert-loading-text">{{t.p1k3kjfi}}</view>
  </view>

  <!-- 操作区 -->
  <view class="cert-actions" wx:if="{{cert}}">
    <button class="save-btn {{type}}" hover-class="btn-hover" bindtap="onSave">{{t.pgor0rw}}</button>
    <view class="cert-tip">{{t.pm7e2c3}}</view>
    <view class="cert-tip">手机端保存到系统相册；电脑端生成后会弹出预览，可右键图片选择「图片另存为」。</view>
  </view>

  <!-- 导出用画布（极低透明度保留在渲染树内，避免离屏画布导不出内容） -->
  <canvas
    type="2d"
    id="certCanvas"
    class="cert-canvas"
    style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
  ></canvas>

  <!-- 桌面端保存兜底：直接展示生成的图片，右键 / 长按即可另存 -->
  <view wx:if="{{preview}}" class="cert-preview-mask" catchtap="closePreview">
    <view class="cert-preview-panel" catchtap="noop">
      <view class="cert-preview-title">证书已生成</view>
      <image
        class="cert-preview-img"
        src="{{preview}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
        binderror="onPreviewError"
      />
      <view class="cert-preview-tip">在电脑上右键图片选择「图片另存为」；手机上长按图片保存。也可以复制文件路径后在开发者工具的文件面板中导出。</view>
      <view class="cert-preview-actions">
        <view class="cert-preview-btn" hover-class="btn-hover" catchtap="copyPreviewPath">复制文件路径</view>
        <view class="cert-preview-btn primary" hover-class="btn-hover" catchtap="closePreview">关闭</view>
      </view>
    </view>
  </view>
</view>
