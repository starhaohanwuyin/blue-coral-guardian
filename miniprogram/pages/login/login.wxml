<!-- 登录页：账号密码（与官网同一账号）+ 微信一键登录绑定 -->
<view class="login-page lang-{{lang}}">
  <!-- 品牌区 -->
  <view class="login-hero">
    <view class="login-bubble lb-1"></view>
    <view class="login-bubble lb-2"></view>
    <view class="login-bubble lb-3"></view>
    <view class="login-fish lf-1">🐟</view>
    <view class="login-fish lf-2 reverse">🐟</view>
    <view class="login-logo">🪸</view>
    <view class="login-brand">{{t.pnorp5y}}</view>
    <view class="login-slogan">{{t.pnh1aau}}</view>
  </view>

  <!-- 表单卡（演示环境：只保留账号密码登录，不做微信一键登录/绑定） -->
  <view class="login-card card">
    <block wx:if="{{!bindMode}}">
      <view class="form-item">
        <view class="form-icon">👤</view>
        <input class="form-input" placeholder="{{t.p1ud8z90}}" value="{{username}}" bindinput="onInput" data-field="username" />
      </view>
      <view class="form-item">
        <view class="form-icon">🔒</view>
        <input class="form-input" placeholder="{{t.p1aph6eg}}" password value="{{password}}" bindinput="onInput" data-field="password" />
      </view>
      <view class="login-btn" hover-class="btn-hover" bindtap="onAccountLogin">{{t.pwsofpa}}</view>
      <view class="login-tip">{{t.p1cnhicz}}</view>
    </block>
  </view>

  <!-- 协议 -->
  <view class="login-agreement">
    <view class="agree-check {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</view>
    <text class="agree-text">{{t.pz7r7wd}}</text>
    <text class="agree-link" bindtap="viewAgreement" data-type="agreement">{{t.pypdsum}}</text>
    <text class="agree-text">{{t.p35ocy9}}</text>
    <text class="agree-link" bindtap="viewAgreement" data-type="privacy">{{t.p196wl08}}</text>
  </view>
</view>
