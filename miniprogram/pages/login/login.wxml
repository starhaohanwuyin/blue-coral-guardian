<!-- 登录页：账号密码（与官网同一账号）+ 微信一键登录绑定 -->
<view class="login-page">
  <!-- 品牌区 -->
  <view class="login-hero">
    <view class="login-bubble lb-1"></view>
    <view class="login-bubble lb-2"></view>
    <view class="login-bubble lb-3"></view>
    <view class="login-fish lf-1">🐟</view>
    <view class="login-fish lf-2 reverse">🐟</view>
    <view class="login-logo">🪸</view>
    <view class="login-brand">{{t.pnorp5y}}</view>
    <view class="login-slogan">{{t.pnh1aau}}</view>
  </view>

  <!-- 表单卡 -->
  <view class="login-card card">
    <!-- Tab 切换 -->
    <view class="login-tabs">
      <view class="login-tab {{mode === 'account' ? 'active' : ''}}" bindtap="switchMode" data-mode="account">{{t.p1nd6e8y}}</view>
      <view class="login-tab {{mode === 'wechat' ? 'active' : ''}}" bindtap="switchMode" data-mode="wechat">{{t.pu98dxo}}</view>
    </view>

    <!-- 账号密码登录 -->
    <block wx:if="{{mode === 'account' && !bindMode}}">
      <view class="form-item">
        <view class="form-icon">👤</view>
        <input class="form-input" placeholder="官网账号 / 用户名" value="{{username}}" bindinput="onInput" data-field="username" />
      </view>
      <view class="form-item">
        <view class="form-icon">🔒</view>
        <input class="form-input" placeholder="密码" password value="{{password}}" bindinput="onInput" data-field="password" />
      </view>
      <view class="login-btn" hover-class="btn-hover" bindtap="onAccountLogin">{{t.pwsofpa}}</view>
      <view class="login-tip">{{t.p1krt8wl}}</view>
    </block>

    <!-- 微信一键登录 -->
    <block wx:if="{{mode === 'wechat' && !bindMode}}">
      <view class="wx-login-area">
        <view class="wx-icon-wrap">💬</view>
        <view class="wx-desc">{{t.p4j7qu1}}</view>
        <view class="login-btn wx-btn" hover-class="btn-hover" bindtap="onWxLogin">{{t.p1dfxxn6}}</view>
        <view class="login-tip">{{t.p16baepy}}</view>
      </view>
    </block>

    <!-- 绑定官网账号（微信未绑定时显示） -->
    <block wx:if="{{bindMode}}">
      <view class="bind-title">{{t.plec4ea}}</view>
      <view class="bind-desc">{{t.pq0h8ri}}</view>
      <view class="form-item">
        <view class="form-icon">👤</view>
        <input class="form-input" placeholder="官网账号 / 用户名" value="{{username}}" bindinput="onInput" data-field="username" />
      </view>
      <view class="form-item">
        <view class="form-icon">🔒</view>
        <input class="form-input" placeholder="密码" password value="{{password}}" bindinput="onInput" data-field="password" />
      </view>
      <view class="login-btn" hover-class="btn-hover" bindtap="onBindSubmit">{{t.pnou1b4}}</view>
      <view class="bind-cancel" bindtap="cancelBind">{{t.p13hri1n}}</view>
      <view class="login-tip">{{t.p13ohhdq}}</view>
    </block>
  </view>

  <!-- 协议 -->
  <view class="login-agreement">
    <view class="agree-check {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</view>
    <text class="agree-text">{{t.pz7r7wd}}</text>
    <text class="agree-link" bindtap="viewAgreement" data-type="agreement">{{t.pypdsum}}</text>
    <text class="agree-text">{{t.p35ocy9}}</text>
    <text class="agree-link" bindtap="viewAgreement" data-type="privacy">{{t.p196wl08}}</text>
  </view>
</view>
