/* ============ 登录页 ============ */
.login-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* 品牌区 */
.login-hero {
  position: relative;
  padding: 100rpx 40rpx 140rpx;
  background: linear-gradient(180deg, #0D47A1, #1565C0 55%, #1E88E5);
  text-align: center;
  overflow: hidden;
}
.login-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  animation: bubbleUp 8s linear infinite;
}
.lb-1 { width: 64rpx; height: 64rpx; top: 24%; left: 12%; }
.lb-2 { width: 36rpx; height: 36rpx; top: 40%; right: 18%; animation-delay: 2s; }
.lb-3 { width: 24rpx; height: 24rpx; top: 60%; left: 70%; animation-delay: 4s; }
.login-fish {
  position: absolute;
  font-size: 36rpx;
  opacity: 0.5;
  animation: swim 13s linear infinite;
}
.login-fish.reverse { animation: swimR 15s linear infinite; }
.lf-1 { top: 40rpx; left: 0; }
.lf-2 { top: 120rpx; }

.login-logo {
  position: relative;
  z-index: 2;
  font-size: 110rpx;
  animation: floatSoft 4s ease-in-out infinite;
}
.login-brand {
  position: relative;
  z-index: 2;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}
.login-slogan {
  position: relative;
  z-index: 2;
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 表单卡 */
.login-card {
  position: relative;
  z-index: 2;
  margin: -90rpx 40rpx 0;
  padding: 40rpx 36rpx;
}

/* Tab 切换 */
.login-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 36rpx;
}
.login-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text2);
  transition: all 0.25s;
}
.login-tab.active {
  background: #fff;
  color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.15);
}

/* 输入项 */
.form-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid transparent;
}
.form-icon { font-size: 34rpx; }
.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
}

/* 登录按钮 */
.login-btn {
  margin-top: 12rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(30, 136, 229, 0.35);
}
.wx-btn {
  background: linear-gradient(135deg, #07C160, #10D06C);
  box-shadow: 0 12rpx 40rpx rgba(9, 187, 7, 0.3);
}
.login-tip {
  font-size: 22rpx;
  color: var(--text3);
  line-height: 1.7;
  text-align: center;
  margin-top: 24rpx;
}

/* 微信登录区 */
.wx-login-area {
  text-align: center;
  padding: 24rpx 0 8rpx;
}
.wx-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: rgba(9, 187, 7, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.wx-desc {
  font-size: 26rpx;
  color: var(--text2);
  margin: 24rpx 0 32rpx;
}

/* 绑定模式 */
.bind-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.bind-desc {
  font-size: 22rpx;
  color: var(--text3);
  line-height: 1.7;
  margin-bottom: 32rpx;
}
.bind-cancel {
  text-align: center;
  font-size: 26rpx;
  color: var(--text3);
  margin-top: 24rpx;
  padding: 8rpx;
}

/* 协议 */
.login-agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 48rpx;
  padding: 0 40rpx;
}
.agree-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid var(--text3);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  box-sizing: border-box;
}
.agree-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.agree-text { font-size: 22rpx; color: var(--text3); }
.agree-link { font-size: 22rpx; color: var(--primary); }
