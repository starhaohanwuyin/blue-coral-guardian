<!-- 积分商城页：养料区 + 文创区 -->
<view class="page-body lang-{{lang}}">
  <!-- 积分头卡 -->
  <view class="shop-points-card">
    <view class="shop-points-left">
      <view class="shop-points-icon">⭐</view>
      <view>
        <view class="shop-points-num">{{points}}</view>
        <view class="shop-points-label">{{t.py0n5tc}}</view>
      </view>
    </view>
    <view class="shop-points-tip">{{t.pkbnk6w}}</view>
  </view>

  <!-- 区域切换 -->
  <view class="shop-tabs">
    <view class="shop-tab {{tab === 'feed' ? 'active' : ''}}" bindtap="switchTab" data-tab="feed">{{t.pv9k517}}</view>
    <view class="shop-tab {{tab === 'culture' ? 'active' : ''}}" bindtap="switchTab" data-tab="culture">{{t.p1xnz385}}</view>
  </view>

  <!-- 养料区 -->
  <block wx:if="{{tab === 'feed'}}">
    <view class="shop-tip card">{{t.pzjowyc}}</view>
    <view class="shop-item card" wx:for="{{feeds}}" wx:key="key">
      <view class="shop-item-icon">{{item.icon}}</view>
      <view class="shop-item-info">
        <view class="shop-item-name">{{item.name}} <text class="shop-item-stock" wx:if="{{shop[item.key] > 0}}">{{t.p1op5xdz}}{{shop[item.key]}}</text></view>
        <view class="shop-item-desc">{{item.desc}} {{t.p1l2w074}}{{item.growth}}%</view>
      </view>
      <view class="shop-buy-btn feed" hover-class="btn-hover" bindtap="onBuyFeed" data-key="{{item.key}}">{{item.price}}{{t.p1f5u8y0}}</view>
    </view>
  </block>

  <!-- 文创区 -->
  <block wx:if="{{tab === 'culture'}}">
    <view class="shop-tip card">{{t.p1sz7m1d}}</view>
    <view class="shop-item card" wx:for="{{cultureItems}}" wx:key="id">
      <view class="shop-item-icon">{{item.icon}}</view>
      <view class="shop-item-info">
        <view class="shop-item-name">{{item.name}} <text class="shop-item-stock" wx:if="{{culture[item.id] > 0}}">{{t.p19ela7d}}{{culture[item.id]}}</text></view>
        <view class="shop-item-desc">{{item.desc}}</view>
      </view>
      <view class="shop-buy-btn culture" hover-class="btn-hover" bindtap="onExchange" data-id="{{item.id}}">{{item.price}}{{t.p1f5u8y0}}</view>
    </view>
  </block>
</view>
