/* ============ 认养页 ============ */

/* 类型切换 */
.adopt-type-tabs {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 8rpx;
}
.adopt-type-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--card);
  color: var(--text2);
  font-size: 28rpx;
  font-weight: 600;
  border: 3rpx solid transparent;
}
.adopt-type-tab.active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(30, 136, 229, 0.06);
}

/* ===== 虚拟养成海洋场景 ===== */
.virtual-ocean {
  position: relative;
  height: 560rpx;
  margin: 24rpx 32rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0D47A1 0%, #1565C0 45%, #0288D1 100%);
  box-shadow: 0 16rpx 48rpx rgba(13, 71, 161, 0.25);
}
.va-ray {
  position: absolute;
  top: -20rpx;
  width: 90rpx;
  height: 380rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0));
  transform: rotate(16deg);
  border-radius: 50%;
}
.va-ray-1 { left: 140rpx; }
.va-ray-2 { left: 420rpx; width: 60rpx; opacity: 0.6; }

.va-fish {
  position: absolute;
  font-size: 36rpx;
  opacity: 0.75;
  animation: swim 12s linear infinite;
}
.va-fish.reverse { animation: swimR 15s linear infinite; animation-delay: 3s; }
.va-fish-1 { top: 140rpx; }
.va-fish-2 { top: 90rpx; animation-delay: 5s; animation-duration: 10s; }
.va-fish-3 { top: 200rpx; font-size: 26rpx; animation-delay: 2s; }

/* 海带 */
.va-kelp {
  position: absolute;
  bottom: 30rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(102, 187, 106, 0.1), #66BB6A);
  transform-origin: bottom center;
  animation: kelpSway 4.5s ease-in-out infinite;
}
.kelp-1 { left: 70rpx; height: 200rpx; }
.kelp-2 { left: 110rpx; height: 140rpx; opacity: 0.6; animation-delay: 0.8s; }
.kelp-3 { right: 90rpx; height: 230rpx; animation-delay: 1.5s; }

/* 气泡 */
.va-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  animation: bubbleUp linear infinite;
}
.vb-1 { left: 15%; bottom: 80rpx; width: 16rpx; height: 16rpx; animation-duration: 6s; }
.vb-2 { left: 35%; bottom: 60rpx; width: 10rpx; height: 10rpx; animation-duration: 8s; animation-delay: 2s; }
.vb-3 { left: 55%; bottom: 100rpx; width: 12rpx; height: 12rpx; animation-duration: 7s; animation-delay: 1s; }
.vb-4 { left: 75%; bottom: 70rpx; width: 14rpx; height: 14rpx; animation-duration: 9s; animation-delay: 3s; }
.vb-5 { left: 45%; bottom: 90rpx; width: 8rpx; height: 8rpx; animation-duration: 5s; animation-delay: 4s; }

.va-starfish {
  position: absolute;
  right: 170rpx;
  bottom: 44rpx;
  font-size: 32rpx;
  opacity: 0.55;
  animation: floatSoft 4s ease-in-out infinite;
}

/* 主珊瑚 */
.va-coral-main {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  font-size: 150rpx;
  filter: drop-shadow(0 10rpx 24rpx rgba(255, 112, 67, 0.45));
  animation: coralFloat 6s ease-in-out infinite;
  z-index: 3;
}
@keyframes coralFloat {
  0%, 100% { transform: translateX(-50%) translateY(0) rotate(-2deg); }
  50% { transform: translateX(-50%) translateY(-14rpx) rotate(2deg); }
}
.va-coral-main.bounce { animation: coralBounce 0.6s ease; }
@keyframes coralBounce {
  0% { transform: translateX(-50%) scale(1); }
  40% { transform: translateX(-50%) scale(1.25); }
  100% { transform: translateX(-50%) scale(1); }
}
.va-coral-glow {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  transform: translateX(-50%);
  width: 260rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 138, 101, 0.3) 0%, rgba(255, 138, 101, 0.08) 50%, transparent 100%);
}
.va-sand {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: radial-gradient(ellipse at 25% 100%, rgba(255, 255, 255, 0.14) 0%, transparent 60%),
    radial-gradient(ellipse at 70% 100%, rgba(255, 255, 255, 0.1) 0%, transparent 60%);
}

/* 状态面板 */
.va-info-panel {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #1565C0, #1E88E5);
  border-radius: var(--radius);
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 16rpx 48rpx rgba(21, 101, 192, 0.3);
}
.va-points-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.va-points { display: flex; align-items: center; gap: 20rpx; }
.va-points-icon { font-size: 52rpx; }
.va-points-num { font-size: 44rpx; font-weight: 700; line-height: 1.1; }
.va-points-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.6); }
.va-coral-count { text-align: right; }
.va-coral-count-icon { font-size: 44rpx; }
.va-coral-count-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.6); }

.va-progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}
.va-progress-title { color: rgba(255, 255, 255, 0.85); }
.va-progress-pct { font-weight: 700; font-size: 28rpx; }
.va-progress-bar {
  height: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  overflow: hidden;
}
.va-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #FFCA28, #FF7043);
  transition: width 0.8s ease;
}
.va-progress-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 12rpx;
}
.va-btn-row { margin-top: 28rpx; display: flex; flex-direction: column; gap: 16rpx; }
.va-feed-btn {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF7043, #FF8A65);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 112, 67, 0.4);
}
.va-shop-btn {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FF9800, #FFC107);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.35);
}

/* 每日任务 */
.va-tasks { padding: 0 32rpx; }
.va-task-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.va-task-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 32rpx rgba(30, 136, 229, 0.07);
}
.va-task-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.va-task-info { flex: 1; min-width: 0; }
.task-name { font-size: 28rpx; font-weight: 600; }
.task-desc { font-size: 22rpx; color: var(--text3); margin-top: 4rpx; }
.va-task-reward { font-size: 22rpx; color: var(--coral); font-weight: 600; flex-shrink: 0; }
.va-task-btn {
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin: 0;
  line-height: 1.5;
}
.va-task-btn.claim {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
}
.va-task-btn.done {
  background: var(--border);
  color: var(--text3);
}
.share-btn { border: none; }
.share-btn::after { border: none; }

/* 虚拟珊瑚列表 */
.shop-link { color: var(--primary); font-weight: 500; }
.virtual-coral-list { padding: 0 32rpx; }
.virtual-coral-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 32rpx rgba(30, 136, 229, 0.07);
}
.virtual-coral-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.virtual-coral-emoji { font-size: 44rpx; }
.virtual-coral-name { font-size: 30rpx; font-weight: 700; flex: 1; }
.virtual-coral-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.virtual-coral-status.growing {
  background: rgba(255, 152, 0, 0.12);
  color: #FF9800;
}
.virtual-coral-status.mature {
  background: rgba(76, 175, 80, 0.12);
  color: var(--green);
}
.virtual-coral-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.virtual-coral-progress-bar {
  flex: 1;
  height: 16rpx;
  background: var(--border);
  border-radius: 8rpx;
  overflow: hidden;
}
.virtual-coral-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 8rpx;
  transition: width 0.8s ease;
}
.virtual-coral-progress-pct { font-size: 24rpx; font-weight: 600; color: var(--primary); }
.virtual-coral-points {
  font-size: 24rpx;
  color: var(--text2);
  margin-top: 16rpx;
}

/* 底部按钮 */
.va-bottom-btns { padding: 8rpx 32rpx 40rpx; display: flex; flex-direction: column; gap: 20rpx; }
.va-cert-btn {
  padding: 22rpx;
  border-radius: 24rpx;
  border: 3rpx solid #4FC3F7;
  color: #4FC3F7;
  background: var(--card);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.va-new-coral-btn {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.3);
}

/* ===== 实体认养 ===== */
.adopt-hero {
  position: relative;
  height: 400rpx;
  margin: 24rpx 32rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0D47A1, #1565C0 50%, #0288D1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ah-fish {
  position: absolute;
  font-size: 34rpx;
  opacity: 0.7;
  animation: swim 14s linear infinite;
}
.ah-fish.reverse { animation: swimR 16s linear infinite; animation-delay: 4s; }
.ah-fish-1 { top: 100rpx; }
.ah-fish-2 { top: 160rpx; }
.ah-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  animation: bubbleUp linear infinite;
}
.ab-1 { left: 20%; bottom: 60rpx; width: 12rpx; height: 12rpx; animation-duration: 7s; }
.ab-2 { left: 65%; bottom: 80rpx; width: 10rpx; height: 10rpx; animation-duration: 9s; animation-delay: 3s; }
.ah-coral {
  position: absolute;
  bottom: 24rpx;
  font-size: 52rpx;
  opacity: 0.85;
  transform-origin: bottom center;
  animation: sway 5s ease-in-out infinite;
}
.ah-coral-1 { left: 60rpx; }
.ah-coral-2 { right: 60rpx; animation-name: sway2; animation-duration: 4s; }
.ah-sand {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70rpx;
  background: radial-gradient(ellipse at 50% 100%, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
}
.adopt-hero-overlay { position: relative; text-align: center; z-index: 2; }
.adopt-hero-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}
.adopt-hero-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 实体产品卡 */
.entity-adopt-cards { padding: 0 32rpx; }
.entity-card { margin-bottom: 24rpx; padding: 32rpx; }
.entity-card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.entity-card-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(30, 136, 229, 0.12), rgba(0, 188, 212, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.entity-card-title { font-size: 32rpx; font-weight: 700; }
.entity-card-sub { font-size: 22rpx; color: var(--text3); margin-top: 6rpx; }
.entity-card-desc {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.7;
}
.entity-card-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}
.entity-feature-tag {
  padding: 8rpx 20rpx;
  background: rgba(30, 136, 229, 0.06);
  color: var(--primary);
  border-radius: 12rpx;
  font-size: 22rpx;
}
.entity-card-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.entity-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--coral);
}
.entity-price-unit { font-size: 22rpx; color: var(--text3); font-weight: 400; }
.entity-buy-btn {
  padding: 18rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(30, 136, 229, 0.3);
}

/* 碳汇 */
.carbon-section { margin: 0 32rpx 24rpx; padding: 32rpx; }
.carbon-ring-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.carbon-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.carbon-ring-inner {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.carbon-num { font-size: 36rpx; font-weight: 700; color: var(--primary); line-height: 1.2; }
.carbon-unit { font-size: 20rpx; color: var(--text3); }
.carbon-info-title { font-size: 30rpx; font-weight: 700; margin-bottom: 10rpx; }
.carbon-info-desc { font-size: 22rpx; color: var(--text2); line-height: 1.7; }

/* 操作面板 */
.adopt-action-row {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
}
.adopt-action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  background: var(--card);
  box-shadow: 0 4rpx 32rpx rgba(30, 136, 229, 0.07);
}
.adopt-action-btn.live { color: var(--coral); border: 3rpx solid rgba(255, 112, 67, 0.4); }
.adopt-action-btn.cert { color: #4FC3F7; border: 3rpx solid rgba(79, 195, 247, 0.5); }

/* 我的珊瑚列表 */
.adopt-list { padding: 0 32rpx 40rpx; }
.adopt-list-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.adopt-list-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--border);
}
.adopt-list-info { flex: 1; min-width: 0; }
.adopt-list-name { font-size: 30rpx; font-weight: 700; }
.adopt-list-sub { font-size: 22rpx; color: var(--text3); margin: 6rpx 0 12rpx; }
.progress-wrap { display: flex; align-items: center; gap: 14rpx; }
.progress-wrap .progress-bar { flex: 1; height: 14rpx; }
.progress-pct { font-size: 22rpx; font-weight: 600; color: var(--primary); }
.carbon-val { font-size: 22rpx; color: var(--green); margin-top: 12rpx; }

/* ===== 喂养弹窗 ===== */
.feed-points-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text2);
  padding: 20rpx;
  background: rgba(30, 136, 229, 0.06);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.feed-points-num { font-size: 36rpx; font-weight: 700; color: var(--primary); }
.feed-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.feed-icon { font-size: 44rpx; width: 64rpx; text-align: center; flex-shrink: 0; }
.feed-info { flex: 1; min-width: 0; }
.feed-name { font-size: 28rpx; font-weight: 600; }
.feed-stock {
  font-size: 22rpx;
  color: var(--coral);
  font-weight: 600;
  margin-left: 8rpx;
}
.feed-desc { font-size: 22rpx; color: var(--text3); margin-top: 4rpx; }
.feed-btn {
  padding: 12rpx 28rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.feed-btn.use {
  background: linear-gradient(135deg, #FF7043, #FF8A65);
  color: #fff;
}
.feed-btn.buy {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
}
.feed-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  padding: 16rpx 0 8rpx;
}

/* ===== 公益活动弹窗 ===== */
.welfare-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--bg);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}
.welfare-icon { font-size: 52rpx; flex-shrink: 0; }
.welfare-info { flex: 1; min-width: 0; }
.welfare-name { font-size: 28rpx; font-weight: 600; }
.welfare-desc { font-size: 22rpx; color: var(--text3); margin-top: 6rpx; }
.welfare-join {
  padding: 12rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #009688, #4DB6AC);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.welfare-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text3);
  padding: 8rpx 0 16rpx;
}
