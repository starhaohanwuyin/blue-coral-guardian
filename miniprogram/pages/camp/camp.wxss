/* ================= 夏令营页 ================= */
.camp-page {
  padding: 32rpx 32rpx 60rpx;
}

.camp-img {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  display: block;
  background: var(--border);
}

/* 统计 */
.camp-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.camp-stat-card {
  background: linear-gradient(135deg, rgba(30, 136, 229, 0.08), rgba(0, 188, 212, 0.08));
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}
.camp-stat-card .num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}
.camp-stat-card .lbl {
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 4rpx;
}

.camp-desc {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
  margin-bottom: 28rpx;
}

/* 城市 */
.camp-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.camp-city-tag {
  padding: 12rpx 28rpx;
  background: rgba(30, 136, 229, 0.08);
  color: var(--primary);
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.camp-section-title {
  font-size: 30rpx;
  font-weight: 700;
  padding: 8rpx 0 20rpx;
}

/* 班型卡片 */
.camp-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.camp-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  border-left: 6rpx solid var(--primary);
  box-shadow: 0 4rpx 32rpx rgba(30, 136, 229, 0.07);
}
.camp-card.accent { border-left-color: var(--accent); }
.camp-card.coral { border-left-color: var(--coral); }

.camp-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.camp-card-name {
  font-size: 28rpx;
  font-weight: 700;
}
.camp-card-price {
  font-size: 24rpx;
  font-weight: 600;
}
.camp-card-price.primary { color: var(--primary); }
.camp-card-price.accent { color: var(--accent); }
.camp-card-price.coral { color: var(--coral); }

.camp-card-target {
  font-size: 24rpx;
  color: var(--text2);
  margin-bottom: 8rpx;
}
.camp-card-content {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
}
.camp-card-note {
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 8rpx;
}
.camp-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.camp-card-tag {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}
.camp-card-tag.primary { background: rgba(30, 136, 229, 0.08); color: var(--primary); }
.camp-card-tag.accent { background: rgba(0, 188, 212, 0.08); color: var(--accent); }
.camp-card-tag.coral { background: rgba(255, 112, 67, 0.08); color: var(--coral); }

/* 报名按钮 */
.camp-apply-btn {
  margin-top: 36rpx;
  width: 100%;
  border: none;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 0;
  box-shadow: 0 8rpx 40rpx rgba(30, 136, 229, 0.3);
}
.camp-apply-btn::after { border: none; }
.btn-hover { transform: scale(0.97); opacity: 0.9; }
.camp-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 20rpx;
}
