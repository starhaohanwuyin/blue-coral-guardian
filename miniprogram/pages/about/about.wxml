<view class="about-page lang-{{lang}}">

  <!-- 品牌头 -->
  <view class="about-hero">
    <view class="about-logo">🪸</view>
    <view class="about-name">{{t.pjvoy6r}}</view>
    <view class="about-slogan">{{t.ppp0fur}}</view>
  </view>

  <!-- 公司简介 -->
  <view class="about-card card">
    <view class="about-card-title">{{t.py9uwtc}}</view>
    <view class="about-intro">{{info.intro}}</view>
    <view class="about-row" wx:for="{{info.rows}}" wx:key="label">
      <text class="label">{{item.label}}</text>
      <text class="value">{{item.value}}</text>
    </view>
  </view>

  <!-- 团队介绍 -->
  <view class="about-card card">
    <view class="about-card-title">{{t.psh9wdr}}</view>
    <view class="about-team-intro">{{teamIntro}}</view>
    <view class="about-member" wx:for="{{team}}" wx:key="name">
      <view class="about-member-head">
        <text class="about-member-name">{{item.name}}</text>
        <text class="about-member-role">{{item.role}}</text>
      </view>
      <view class="about-member-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="about-footer">
    <view class="about-footer-row" bindtap="onCopyEmail">{{t.ptoc121}}{{email}}</view>
    <view class="about-footer-row">{{t.p16sjc6b}}{{version}}</view>
    <view class="about-footer-row">{{t.p2zexnw}}</view>
  </view>
</view>
