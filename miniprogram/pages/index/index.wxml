<!-- 首页：海洋动画 + 数据模块 -->
<view class="page-body lang-{{lang}}">
  <!-- 自定义导航头 -->
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-header-row">
      <view class="logo-wrap">
        <view class="logo">🪸 {{t.brand}}</view>
        <view class="logo-sub">Reef-Blue</view>
      </view>
      <view class="sub">{{t.slogan}}</view>
      <!-- 全中文模式：不显示中英切换按钮（要恢复就把下一行取消注释，并清空 utils/i18n.js 的 FORCE_LANG） -->
      <!-- <view class="lang-btn" hover-class="btn-hover" bindtap="toggleLang">{{langBtn}}</view> -->
    </view>
  </view>

  <!-- ===== 海洋Hero场景（CSS动画还原SVG场景） ===== -->
  <view class="home-hero">
    <!-- 光柱 -->
    <view class="hero-ray ray-1"></view>
    <view class="hero-ray ray-2"></view>
    <!-- 游动鱼群 -->
    <view class="hero-fish fish-1">🐟</view>
    <view class="hero-fish fish-2 reverse">🐟</view>
    <view class="hero-fish fish-3">🐡</view>
    <!-- 海底珊瑚群 -->
    <view class="hero-coral coral-1">🪸</view>
    <view class="hero-coral coral-2">🪸</view>
    <view class="hero-coral coral-3">🐚</view>
    <view class="hero-coral coral-4">🪨</view>
    <!-- 气泡 -->
    <view class="hero-bubble bubble-1"></view>
    <view class="hero-bubble bubble-2"></view>
    <view class="hero-bubble bubble-3"></view>
    <view class="hero-bubble bubble-4"></view>
    <!-- 海床 -->
    <view class="hero-seafloor"></view>

    <!-- 认养入口卡 -->
    <view class="adopt-card">
      <view class="adopt-title">{{t.heroTitle}}</view>
      <view class="adopt-desc">{{t.heroDesc}}</view>
      <view class="energy-bar">
        <view class="energy-fill">
          <view class="energy-fill-inner" style="width: {{energyPercent}}%;"></view>
        </view>
        <text class="energy-label">{{t.growth}} {{energy.cur}}/{{energy.max}}</text>
      </view>
      <view class="btn-adopt" hover-class="btn-hover" bindtap="goMyCoral">{{t.heroBtn}}</view>
    </view>
  </view>

  <!-- ===== 平台数据 ===== -->
  <view class="stats-strip">
    <view class="stat-item" wx:for="{{stats}}" wx:key="label">
      <view class="stat-num">{{item.num}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- ===== 碳汇贡献卡 ===== -->
  <view class="carbon-home-card card">
    <view class="carbon-home-icon">🌿</view>
    <view class="carbon-home-info">
      <view class="carbon-home-title">{{t.carbonTitle}}<text class="carbon-val">{{carbon.value}} {{carbon.unit}}</text></view>
      <view class="carbon-home-desc">{{carbon.desc}}</view>
    </view>
  </view>

  <!-- ===== 气候与珊瑚（气候韧性） ===== -->
  <view class="climate-home-card card" wx:if="{{climate.title}}">
    <view class="climate-home-head">
      <view class="climate-home-icon">🌡️</view>
      <view class="climate-home-headtext">
        <view class="climate-home-title">{{climate.title}}</view>
        <view class="climate-home-sub">{{climate.sub}}</view>
      </view>
      <view class="climate-home-tag">{{climate.tag}}</view>
    </view>
    <view class="climate-home-metrics">
      <view class="climate-metric" wx:for="{{climate.metrics}}" wx:key="label">
        <view class="climate-metric-val">{{item.value}}</view>
        <view class="climate-metric-label">{{item.label}}</view>
      </view>
    </view>
    <view class="climate-home-desc">{{climate.desc}}</view>
  </view>

  <!-- ===== 快捷功能 ===== -->
  <view class="section-title">{{t.quick}}</view>
  <view class="quick-actions">
    <view class="action-item" wx:for="{{actions}}" wx:key="name" hover-class="action-hover" bindtap="onAction" data-action="{{item.action}}">
      <view class="action-icon" style="background: {{item.bg}};">{{item.icon}}</view>
      <text class="action-name">{{item.name}}</text>
    </view>
  </view>

  <!-- ===== 我的珊瑚（横滑） ===== -->
  <view class="section-title">{{t.mine}} <text class="more" bindtap="goMyAdopt">{{t.mineMore}}</text></view>
  <scroll-view class="my-coral-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="coral-card" wx:for="{{corals}}" wx:key="id" hover-class="card-hover" bindtap="goCoralDetail" data-id="{{item.id}}">
      <view class="coral-card-imgwrap">
        <image class="coral-card-img" src="{{item.img}}" mode="aspectFill" lazy-load />
        <view class="coral-badge">{{item.species}}</view>
      </view>
      <view class="coral-card-body">
        <view class="coral-card-name">{{item.name}}</view>
        <view class="coral-card-sub">{{t.adoptedAt}} {{item.date}} · {{t.growthPct}} {{item.growth}}%</view>
      </view>
    </view>
  </scroll-view>

  <!-- ===== 核心技术 ===== -->
  <view class="section-title">{{t.tech}}</view>
  <view class="tech-showcase">
    <view class="tech-card card" wx:for="{{tech}}" wx:key="title">
      <view class="tech-card-imgwrap">
        <image class="tech-card-img" src="{{item.img}}" mode="aspectFill" lazy-load />
        <view class="tech-label">{{item.label}}</view>
      </view>
      <view class="tech-card-body">
        <view class="tech-card-title">{{item.title}}</view>
        <view class="tech-card-desc">{{item.desc}}</view>
        <view class="tech-tag-row">
          <text class="tech-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 团队视频 ===== -->
  <view class="section-title">{{t.video}}</view>
  <view class="team-video-section card">
    <!-- 网页版直接内嵌播放器；小程序端暂用封面 + 提示（本地视频需放进包内或用网络地址） -->
    <video
      wx:if="{{canPlayVideo}}"
      class="video-player"
      src="{{videoUrl}}"
      poster="{{videoCover}}"
      controls="{{true}}"
      preload="metadata"
      playsinline="{{true}}"
    ></video>
    <view wx:else class="video-wrapper" hover-class="card-hover" bindtap="onVideoTap">
      <image class="video-cover" src="{{videoCover}}" mode="aspectFill" lazy-load />
      <view class="play-icon">
        <view class="play-triangle"></view>
      </view>
      <view class="video-hint">{{t.videoHint}}</view>
    </view>
    <view class="video-caption">{{videoCaption}}</view>
  </view>

  <!-- ===== 推文&资讯 ===== -->
  <view class="section-title">{{t.articles}}</view>
  <view class="articles-section">
    <view class="article-card card" wx:for="{{articles}}" wx:key="id" hover-class="card-hover" bindtap="goArticle" data-id="{{item.id}}">
      <image class="article-cover" src="{{item.img}}" mode="aspectFill" lazy-load />
      <view class="article-body">
        <view class="article-title">{{item.title}}</view>
        <view class="article-meta">
          <text class="article-date">{{item.date}}</text>
          <text class="tag">{{item.tag}}</text>
        </view>
      </view>
      <view class="wechat-icon">🔗</view>
    </view>
  </view>

  <!-- ===== 最新动态 ===== -->
  <view class="section-title">{{t.news}}</view>
  <view class="news-list">
    <view class="news-item card" wx:for="{{news}}" wx:key="id" hover-class="card-hover" bindtap="goNews" data-id="{{item.id}}">
      <image class="news-img" src="{{item.img}}" mode="aspectFill" lazy-load />
      <view class="news-content">
        <view class="news-title">{{item.title}}</view>
        <view class="news-sub">{{item.date}} · {{item.tag}}</view>
      </view>
    </view>
  </view>
</view>
