<view class="ma-page lang-{{lang}}">

  <!-- 认养列表 -->
  <view class="my-adopt-card" wx:for="{{corals}}" wx:key="id">
    <image class="my-adopt-img" src="{{item.img}}" mode="aspectFill" />
    <view class="my-adopt-info">
      <view class="ma-name">{{item.name}}</view>
      <view class="ma-sub">{{item.species}} {{t.p8uy5bl}}{{item.code}}</view>
      <view class="ma-progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.growth}}%"></view>
        </view>
        <text class="ma-progress-pct">{{item.growth}}%</text>
      </view>
      <view class="ma-carbon">{{t.pthuzc1}}{{item.carbon}} g CO₂</view>
      <button class="ma-detail-btn" hover-class="btn-hover" data-id="{{item.id}}" bindtap="goDetail">{{t.pox3r68}}</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{loaded && !corals.length}}">
    {{t.p17z5e5f}}
  </view>

  <!-- AI 养护建议 -->
  <view class="ma-advice-card">
    <view class="ma-advice-title">{{t.prljdk4}}</view>
    <view class="ma-advice-body">
      <view class="ma-advice-item"><text class="ma-bold">{{t.p1udj46x}}</text> {{t.p73wn19}}</view>
      <view class="ma-advice-item"><text class="ma-bold">{{t.p1ytk06m}}</text> {{t.p1llwl30}}</view>
      <view class="ma-advice-item"><text class="ma-bold">{{t.p1ytnhhz}}</text> {{t.p1sk90v5}}</view>
    </view>
    <button class="ma-advice-btn" hover-class="btn-hover" bindtap="goAi">{{t.p178dww5}}</button>
  </view>
</view>
