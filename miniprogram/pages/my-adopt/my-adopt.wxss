/* ================= 我的认养页 ================= */
.ma-page {
  padding: 32rpx 32rpx 60rpx;
}

/* 认养卡 */
.my-adopt-card {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 32rpx rgba(30, 136, 229, 0.07);
  margin-bottom: 24rpx;
  display: flex;
  gap: 28rpx;
  padding: 28rpx;
}
.my-adopt-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: var(--border);
  flex-shrink: 0;
}
.my-adopt-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.ma-name {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}
.ma-sub {
  font-size: 22rpx;
  color: var(--text3);
  margin-bottom: 12rpx;
}
.ma-progress-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.ma-progress-wrap .progress-bar {
  flex: 1;
  height: 12rpx;
}
.ma-progress-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  min-width: 72rpx;
  text-align: right;
}
.ma-carbon {
  font-size: 22rpx;
  color: var(--green);
  margin-bottom: 12rpx;
}
.ma-detail-btn {
  align-self: flex-start;
  padding: 10rpx 28rpx;
  border: none;
  border-radius: 16rpx;
  background: rgba(30, 136, 229, 0.1);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
}
.ma-detail-btn::after { border: none; }

/* AI 建议 */
.ma-advice-card {
  background: rgba(76, 175, 80, 0.04);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 8rpx;
}
.ma-advice-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.ma-advice-body {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.8;
}
.ma-advice-item {
  margin-bottom: 12rpx;
}
.ma-advice-item:last-child {
  margin-bottom: 0;
}
.ma-bold {
  font-weight: 700;
  color: var(--text);
}
.ma-advice-btn {
  width: 100%;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border: 3rpx solid var(--primary);
  border-radius: 20rpx;
  background: transparent;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}
.ma-advice-btn::after { border: none; }
.btn-hover { transform: scale(0.97); opacity: 0.9; }
