<!-- 推文/资讯详情页 -->
<view class="page-body">
  <view wx:if="{{a}}">
    <image class="art-hero" src="{{a.img}}" mode="aspectFill" />

    <view class="art-body card">
      <view class="art-title">{{a.title}}</view>
      <view class="art-meta">
        <text class="art-date">{{a.date}}</text>
        <text class="tag">{{a.tag}}</text>
      </view>
      <view class="art-divider"></view>

      <!-- 正文：有 paragraphs 就渲染全文，否则退回一句摘要 -->
      <block wx:if="{{a.paragraphs}}">
        <view class="art-paragraph" wx:for="{{a.paragraphs}}" wx:for-item="p" wx:key="*this">{{p}}</view>
      </block>
      <view wx:else class="art-summary">「{{a.title}}」—— 来自蓝珊科技的最新动态。蓝珊科技致力于海洋珊瑚礁生态保护与修复，通过"良种培育 + 智能监测 + 生态恢复 + 公众参与"四位一体模式，守护海洋珊瑚礁生态系统。</view>

      <!-- 延伸阅读链接 -->
      <view wx:if="{{a.url}}" class="art-link card">
        <view class="art-link-title">🔗 {{a.urlName || '原文链接'}}</view>
        <view class="art-link-url">{{a.url}}</view>
        <view class="art-link-btn" hover-class="btn-hover" bindtap="onOpenLink">{{t.pmkqva9}}</view>
        <view class="art-link-btn ghost" hover-class="btn-hover" bindtap="onCopyLink">{{t.p2zaaqj}}</view>
        <view class="art-link-tip">{{linkTip}}</view>
      </view>

      <view wx:else class="art-nolink">{{t.pfwtgbf}}</view>
    </view>
  </view>
  <view wx:else class="loading-dots">{{t.pldc0z9}}</view>
</view>
