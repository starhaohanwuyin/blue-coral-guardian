<!-- 珊瑚详情页：环形进度 + 生长记录时间线 -->
<view class="page-body lang-{{lang}}">
  <view wx:if="{{d}}">
    <!-- 头图 -->
    <view class="cd-imgwrap">
      <image class="cd-img" src="{{d.img}}" mode="aspectFill" />
      <view class="cd-species-badge">{{d.species}}</view>
      <view class="cd-live" wx:if="{{d.liveTag}}">{{t.p18m0pjd}}</view>
    </view>

    <!-- 信息卡 -->
    <view class="cd-card card">
      <view class="cd-name">{{d.name}}</view>

      <!-- 环形进度 + 成长信息 -->
      <view class="cd-progress">
        <view class="cd-ring" style="background: conic-gradient(var(--primary) 0deg {{deg}}deg, #E8EDF5 {{deg}}deg 360deg);">
          <view class="cd-ring-inner">
            <text class="cd-ring-num">{{d.growth}}%</text>
            <text class="cd-ring-label">{{t.pouhwk5}}</text>
          </view>
        </view>
        <view class="cd-progress-info">
          <view class="cd-info-title">{{t.pouhwk5}} {{d.growth}}%</view>
          <view class="cd-info-row">{{t.pm2lqe6}} {{d.remain}} {{t.p1jzmt6n}}</view>
          <view class="cd-info-row">{{t.p1olzbow}}{{d.area}}</view>
          <view class="cd-info-row">{{t.pnxe90r}}{{d.species}}</view>
        </view>
      </view>

      <!-- 成长进度条 -->
      <view class="cd-bar">
        <view class="progress-bar"><view class="progress-fill" style="width: {{d.growth}}%;"></view></view>
      </view>
    </view>

    <!-- 生长记录 -->
    <view class="cd-section-title">{{t.po95zfo}}</view>
    <view class="cd-timeline card">
      <view class="timeline" style="padding: 32rpx 32rpx 8rpx;">
        <view class="timeline-item" wx:for="{{d.timeline}}" wx:key="time">
          <view class="time">{{item.time}}</view>
          <view class="desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="cd-actions">
      <view class="cd-action-btn" hover-class="btn-hover" bindtap="goCamera">{{t.p1rsy0v1}}</view>
      <view class="cd-action-btn" hover-class="btn-hover" bindtap="goCert">{{t.p1eun40y}}</view>
    </view>
  </view>
  <view wx:else class="loading-dots">{{t.pldc0z9}}</view>
</view>
