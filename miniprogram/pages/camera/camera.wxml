<!-- 实时海景页：水下摄像头画面 + 环境指标 -->
<view class="page-body lang-{{lang}}">
  <!-- 画面区 -->
  <view class="cam-view">
    <image class="cam-img" src="{{d.img}}" mode="aspectFill" />
    <!-- 直播标记 -->
    <view class="cam-live">
      <view class="cam-live-dot"></view>
      <text>LIVE</text>
    </view>
    <!-- 位置坐标 -->
    <view class="cam-location">📍 {{d.location}}</view>
    <view class="cam-coord">{{d.coord}}</view>
    <!-- 水下气泡效果 -->
    <view class="cam-bubble cb-1"></view>
    <view class="cam-bubble cb-2"></view>
    <view class="cam-bubble cb-3"></view>
  </view>

  <!-- 环境指标 -->
  <view class="cam-metrics">
    <view class="cam-metric card" wx:for="{{d.metrics}}" wx:key="label">
      <view class="cam-metric-icon">{{item.icon}}</view>
      <view class="cam-metric-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 说明 -->
  <view class="cam-note card">
    <view class="cam-note-title">{{t.p1vkmgdj}}</view>
    <view class="cam-note-text">{{t.p1b0c5wp}}</view>
    <view class="cam-refresh" hover-class="btn-hover" bindtap="onRefresh">{{t.pylqw4e}}</view>
  </view>
</view>
